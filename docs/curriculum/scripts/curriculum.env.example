# curriculum.env — one-time lab setup, sourced by every module lab.
#
# WHY: the labs are "copy-pasteable with no placeholders." That is only possible for
# per-deployment secrets (your client IDs, secrets, Authlete service) if you set them
# ONCE here and every command reads them as shell variables. Fill this in, then:
#
#     cp curriculum.env.example curriculum.env
#     # edit curriculum.env with your values
#     set -a; source curriculum.env; set +a
#
# After that, lab commands like  curl -u "$MGMT_CLIENT_ID:$MGMT_CLIENT_SECRET" ...
# run verbatim. NEVER commit curriculum.env — it holds live credentials. (It is
# gitignored by the curriculum .gitignore.)

# ---- Where the lab lives ----
export AS="http://localhost:3000"            # the authorization server (npm --prefix server run dev)
export API="$AS/api"                          # all API routes are under /api
export DASH="http://localhost:3001"           # the React dashboard (npm --prefix client run dev)

# ---- Interactive login (server demo users; default admin/password) ----
export LAB_USER="admin"
export LAB_PASS="password"

# ---- A confidential client you registered on your Authlete service ----
# Create via the dashboard "Client Management" section or DCR (Module 04).
export CLIENT_ID=""
export CLIENT_SECRET=""
export REDIRECT_URI="http://localhost:3001/callback"

# ---- A public client (no secret) for the PKCE labs (Module 03) ----
# Its idTokenSignAlg must be asymmetric (ES256 or RS256) — Module 08 §3d validates
# an ID token from this client against the JWKS rather than a shared secret.
export PUB_CLIENT_ID=""

# ---- A client using private_key_jwt with a registered JWKS ----
# Needed by Module 06 Exercise 4 (RFC 7523 §2.2) and Module 05 Exercise 2 Step 7 (asymmetric JAR).
#
# Generate the pair LOCALLY — a private key should not be produced by, or pass through, a
# third-party website, however reputable. One command, no dependencies:
#
#   node -e '
#   const c=require("crypto"),f=require("fs");
#   const {privateKey,publicKey}=c.generateKeyPairSync("ec",{namedCurve:"P-256"});
#   const kid="pkjwt-1";
#   const pub={...publicKey.export({format:"jwk"}),kid,use:"sig",alg:"ES256"};
#   const priv={...privateKey.export({format:"jwk"}),kid,use:"sig",alg:"ES256"};
#   console.log("REGISTER THIS as the client JWK Set:\n"+JSON.stringify({keys:[pub]}));
#   console.log("\nPUT THIS in PKJWT_PRIVATE_JWK:\n"+JSON.stringify(priv));'
#
# Then register the PUBLIC half as the client's JWK Set — console, or:
#   curl -s -X PATCH "$API/client/update/<clientId>" -u "$MGMT_CLIENT_ID:$MGMT_CLIENT_SECRET" \
#     -H "Content-Type: application/json" -d '{"jwks":"<the {\"keys\":[...]} string>"}'
#
# Three things that bite, in the order people hit them:
#  1. PKJWT_PRIVATE_JWK is a SINGLE JWK — `{"kty":"EC",...}`. NOT a JWK Set `{"keys":[...]}`.
#     The labs do JSON.parse(...).kid and createPrivateKey({key:<this>}); a Set fails both, and
#     most online generators hand you the Set form.
#  2. It must contain `d` (the private half) and a `kid` that MATCHES the registered public key.
#  3. PKJWT_CLIENT_ID is the CONFIDENTIAL private_key_jwt client — not PUB_CLIENT_ID, which is
#     public and cannot hold a key at all.
#
# Single-quote the value so the JSON survives shell sourcing. Never commit it.
export PKJWT_CLIENT_ID=""
export PKJWT_PRIVATE_JWK=''

# ---- Admin/management credentials (protect /api/token/*, DCR register, HSK, etc.) ----
# These must match MGMT_CLIENT_ID / MGMT_CLIENT_SECRET in server/.env.
export MGMT_CLIENT_ID=""
export MGMT_CLIENT_SECRET=""

# ---- Default scopes used across labs ----
export SCOPES="openid profile email"
