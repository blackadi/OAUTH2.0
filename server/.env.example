# Authlete Configuration — all three are REQUIRED. The server throws on startup if any
# is missing or empty (see src/utils/env.ts). Get them from https://console.authlete.com/
AUTHLETE_BEARER_TOKEN=your_authlete_bearer_token_here
# Use the cluster your service lives in: https://us.authlete.com, https://eu.authlete.com,
# https://jp.authlete.com — or your own Authlete deployment's URL.
AUTHLETE_BASE_URL=https://eu.authlete.com
AUTHLETE_SERVICE_ID=your_authlete_service_id_here

# Server Configuration
PORT=3000

# NODE_ENV — the line below sets `development`, which is right for THIS file (a local
# dev config) and wrong for anywhere else. Read this before copying it to a server.
#
# The code default when NODE_ENV is UNSET is `production`, deliberately. It used to be
# `development`, and the hosted deployment never set the variable — so the
# development-only gate never fired and POST /api/device/complete, which approves a
# device authorization as ANY subject the caller names, was reachable on the public
# internet. Failing safe is the fix; do not "restore" the old default.
#
# So: keep `development` locally, and set `production` (or leave it unset) everywhere
# else. `npm run dev` sets development explicitly anyway, and the server logs a loud
# warning whenever the resolved environment is development.
NODE_ENV=development

MORGAN_FORMAT=combined
# Winston level. Leave unset for the environment-aware default, which is `info` unless
# NODE_ENV is explicitly `development` — note that an UNSET NODE_ENV resolves to
# production first, so unset means `info`, not `debug`. Setting LOG_LEVEL overrides both.
# LOG_LEVEL=info

# Session Configuration — REQUIRED. The server throws on startup if this is empty.
# Only non-emptiness is enforced, so the placeholder below will start the server; it is
# not a usable secret. Generate a real one:
#
#     openssl rand -base64 32
#
SESSION_SECRET=change_this_to_a_random_secret_in_production

# Redis — unset to use in-memory store (session data lost on restart)
# For local Docker Redis: redis://localhost:6379
# REDIS_URL=redis://localhost:6379

# CORS — comma-separated list of allowed origins.
# Since 2026-08-12 this is CORS only. It no longer has any say in where logout may redirect.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Logout — the "Return to application" link on the signed-out page, and the client ID shown on it.
# LOGOUT_REDIRECT_URI is display only; it does not authorise a redirect.
LOGOUT_REDIRECT_URI=http://localhost:3000
LOGOUT_CLIENT_ID=your_client_id_here

# Registered post-logout redirect URIs, per client — this is what actually authorises a redirect.
#
# OpenID Connect RP-Initiated Logout 1.0 §3 requires the OP to redirect only to a URI the *client*
# previously registered, matched exactly. Authlete 3.0 has no client field for these (verified against
# docs/openapi-spec.json 3.0.16 — a write is accepted with 200 and silently discarded), so this deployment
# holds the registry itself. Format: {"<clientId>": ["<exact uri>", ...]}.
#
# Unset, malformed, or missing the client ⇒ that client can never be redirected, which is §3's own answer.
# Values are matched byte-for-byte: "http://localhost:3000" does NOT match "http://localhost:3000/".
# POST_LOGOUT_REDIRECT_URIS={"1234567890":["http://localhost:3000","http://localhost:3001"]}

# Demo users — semicolon-separated: subject:username:password:display_name
# AUTH_USERS=admin:admin:password:Admin User;sub2:user2:pass2:Name2

# JWT keys — for locally-signed JWTs (createLocalToken endpoint, dev only)
# JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nMFkw......\n-----END PUBLIC KEY-----\n"
# JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nMEE......\n-----END PRIVATE KEY-----\n"
# JWT_ISSUER=https://example.test/

# Receiving back-channel logout tokens from ANOTHER OP (POST /api/backchannel_logout).
# Here this server is the RP, not the OP, so all three describe that other OP's relationship with us.
# All three are required together: with any of them missing the endpoint answers 500 rather than
# verifying a token against expectations it does not have. Omitting an `iss`/`aud` check silently
# downgrades it to "any issuer, any audience", which is why unconfigured refuses instead of skipping.
#
# JWKS_URI                     — where that OP publishes the keys its logout tokens are signed with
# BACKCHANNEL_LOGOUT_ISSUER    — that OP's issuer identifier; the expected `iss`
# BACKCHANNEL_LOGOUT_AUDIENCE  — THIS deployment's client_id AT that OP; the expected `aud`.
#                                Not JWT_ISSUER, which describes tokens this server mints itself.
# JWKS_URI=https://other-op.example.com/.well-known/jwks.json
# BACKCHANNEL_LOGOUT_ISSUER=https://other-op.example.com
# BACKCHANNEL_LOGOUT_AUDIENCE=our-client-id-at-that-op

# ---------------------------------------------------------------------------
# Admin API credentials — YOU MAKE THESE UP. They are not from Authlete.
# ---------------------------------------------------------------------------
# Despite the names, these are NOT an OAuth client_id / client_secret and there
# is no "correct" value to go and look up. They are simply a username and
# password for this deployment's own admin endpoints, compared directly against
# what you put here (`src/middleware/require-basic-auth.ts`). Nothing outside
# this repo knows or validates them.
#
# Contrast: AUTHLETE_BEARER_TOKEN / AUTHLETE_SERVICE_ID above DO come from the
# Authlete console (https://console.authlete.com). These two do not.
#
# Pick any username; generate the secret:
#
#     openssl rand -base64 32
#
# Then use them as HTTP Basic credentials:
#
#     curl -u "admin:<your-secret>" http://localhost:3000/api/client/list
#
# They guard client management, token management, HSK, DCR registration, VCI
# offers, backchannel logout, federation registration, native SSO, JAR
# processing and both introspection endpoints.
#
# FAILS CLOSED: leave either blank and every one of those endpoints answers 401
# — including in development. That is deliberate. It used to allow all requests
# when unset, which silently disabled auth on routes that return a confidential
# client's secret in plaintext.
#
# A colon in the secret is fine — the decoder splits on the first colon only.
# Set these in your hosting provider's environment too; this file is local only.
MGMT_CLIENT_ID=
MGMT_CLIENT_SECRET=

# FAPI 2.0 and DPoP settings are read dynamically from the Authlete API
# (authleteApi.service.get().fapiModes and .dpopNonceRequired).
# Configure FAPI modes and DPoP in the Authlete console (https://console.authlete.com).

# RFC 9728 Protected Resource Metadata, served at /.well-known/oauth-protected-resource.
# Optional. If unset, the endpoint advertises this deployment's UserInfo endpoint as the resource.
PROTECTED_RESOURCE_IDENTIFIER=
PROTECTED_RESOURCE_DOCUMENTATION=

# ─── E2E test credentials (npm run test:e2e only) ─────────────────────────────
# The E2E suite talks to the REAL Authlete API and gates whole blocks on these.
# Missing values SKIP tests rather than fail them, so an incomplete set looks like a
# passing run while most of the suite never executes. Set them all to get real coverage.
#
#   CID + SEC      unlock 14 blocks: client credentials, password, authorization code,
#                  refresh, claims, resource indicator, grant management, CIBA,
#                  JWT bearer, token exchange, device flow, PAR, token management
#   PUB_CID        unlocks PKCE (RFC 7636) and the public-client PAR block
#   REDIR          must be a redirect URI registered on BOTH clients above,
#                  otherwise the authorization-code and PAR blocks fail on mismatch
#   MGMT_CLIENT_ID + MGMT_CLIENT_SECRET
#                  gate the `hasManagement` blocks (DCR, token management). These are the
#                  SAME admin credentials configured above — not extra values — but they
#                  are listed here because a suite that silently skips is exactly what the
#                  warning above is about, and this pair is easy to overlook when the
#                  other four are the ones described as "E2E credentials"
#
# Requirements the tests assume:
#   - CID is a CONFIDENTIAL client. Its registered client-auth method must match how the
#     tests present credentials (they use HTTP Basic), so CLIENT_SECRET_BASIC.
#   - PUB_CID is a PUBLIC client and must NOT use a symmetric idTokenSignAlg. HS256 signs
#     the ID token with the client secret, which a public client has no right to hold, so
#     Authlete refuses with [A406301]. Use RS256 or ES256.
#
# CID=your_confidential_client_id
# SEC=your_confidential_client_secret
# PUB_CID=your_public_client_id
# REDIR=http://localhost:3001/callback
#
# Base URL for the standalone tests/e2e/enable_ciba.ts helper script only.
# BASE_URL=http://localhost:3000

# ─── Curriculum labs use a DIFFERENT file ─────────────────────────────────────
# The hands-on modules under docs/curriculum/ need their own variables — $ISS,
# $API, $PKJWT_CLIENT_ID, $PKJWT_PRIVATE_JWK and others. They belong in
# docs/curriculum/scripts/curriculum.env.example, not here, because they are
# shell exports for lab commands rather than server configuration.
#
# Two traps if you put them here instead:
#   - nothing in server/src reads any PKJWT_* variable, so setting them here has
#     no effect on the running server at all;
#   - the labs expect PKJWT_CLIENT_ID. PKJWT_CID is a different name and the lab
#     commands will silently substitute an empty string for it.
#
# MGMT_CLIENT_ID / MGMT_CLIENT_SECRET must match between the two files — the lab
# curl commands authenticate to this server's admin API with them.
