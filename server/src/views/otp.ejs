<%- include('partials/head', { title: 'Enter code' }) %>
<body>
  <main>
  <div class="card card-narrow">
    <div class="login-header">
      <h1>Enter your code</h1>
      <p>This request asked for a stronger authentication method (RFC 9470). Enter the 6-digit code from
        your authenticator app.</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error-message" role="alert"><span class="error-icon" aria-hidden="true">!</span><%= error %></div>
    <% } %>

    <form method="POST" action="/api/session/otp" id="otp-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label for="code">6-digit code</label>
      <input id="code" name="code" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6"
        placeholder="000000" autocomplete="one-time-code" required autofocus />
      <div class="actions">
        <button type="submit" name="otp" value="submit" class="primary" id="btn-submit">Verify</button>
        <button type="submit" name="otp" value="cancel" class="secondary" formnovalidate>Cancel</button>
      </div>
    </form>
    <div class="foot">
      <p class="base">Add this to any TOTP authenticator app (Google Authenticator, Authy, 2FAS, Aegis, ...):</p>
      <div class="code-value-row">
        <span class="base"><strong>Secret key:</strong> <i><%= secret %></i></span>
        <button class="copy-btn" type="button" data-copy="<%= secret %>" aria-label="Copy TOTP secret">Copy</button>
      </div>
      <p class="base">Manual setup: Add account &rarr; enter setup key &rarr; time-based, SHA1, 6 digits, 30s.</p>
      <p class="base">On a phone with an authenticator app installed, you can also
        <a href="<%= otpauthUri %>">tap here to add it automatically</a> — this link does nothing on a
        desktop browser, since there is no app registered to open it.</p>
    </div>
  </div>
  </main>
  <%- include('partials/footer') %>
  <script>
    (function(){
      document.getElementById('code')?.focus();

      var form = document.getElementById('otp-form');
      var btn = document.getElementById('btn-submit');
      if (form && btn) {
        form.addEventListener('submit', function(e) {
          var submitter = e.submitter;
          if (submitter && submitter.value !== 'submit') return;
          btn.disabled = true;
          btn.innerHTML = '<span class="spinner"></span> Verifying…';
        });
      }

      // Same copy-to-clipboard behavior as views/index.ejs's authorization-code display.
      document.querySelectorAll('[data-copy]').forEach(function(copyBtn) {
        copyBtn.addEventListener('click', function() {
          if (!navigator.clipboard) return;
          navigator.clipboard.writeText(copyBtn.getAttribute('data-copy')).then(function() {
            var orig = copyBtn.textContent;
            copyBtn.textContent = 'Copied!';
            copyBtn.classList.add('copied');
            setTimeout(function() { copyBtn.textContent = orig; copyBtn.classList.remove('copied'); }, 1500);
          });
        });
      });
    })();
  </script>
</body>
</html>
