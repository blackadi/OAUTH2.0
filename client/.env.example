# API base URL — required. Points to the deployed Authlete Node server.
# NOTE: the Vite dev-server proxy target is hardcoded to http://localhost:3000 in
# vite.config.ts. If you change the server's PORT, update both this value and that proxy.
VITE_API_BASE_URL=http://localhost:3000

# ⚠️ EVERY VITE_* VALUE BELOW IS PUBLIC. Vite inlines them into the JavaScript bundle
# at build time, so they ship to every browser that loads the app and can be read with
# "view source". They are form pre-fills and build-time settings, never secrets.
# Nothing here is protected by being in a .env file — that only keeps it out of git.

# Optional defaults that pre-fill the dashboard forms.
# All credentials can also be entered directly in the UI.
VITE_CLIENT_ID=your_client_id
# Pre-fills the client-secret fields in the Grant Flows section (authorization code,
# client credentials, password, refresh, JWT bearer). LEAVE IT EMPTY for a public
# client, which is what the SPA's own client is.
#
# The literal "your_client_secret" is recognised as a placeholder and treated as
# absent (`secretOrEmpty` in src/config.ts), because a placeholder that reaches the
# token endpoint does not merely fail — any non-empty secret switches the request from
# "no client authentication" to "client authentication attempted", and Authlete refuses
# that for a public client with [A157303]. That once broke the headline PKCE flow, and
# the error named the credential rather than its presence.
#
# ⚠️ Read the warning above before setting this to a real secret. A confidential
# client's secret placed here is embedded in the shipped bundle and is no longer
# confidential — which is the whole reason RFC 9700 §2.1.1 treats browser apps as
# public clients that use PKCE instead of a secret. It exists here only so a local
# demo can exercise the confidential flow against a throwaway client.
VITE_CLIENT_SECRET=
VITE_REDIRECT_URI=http://localhost:3001/callback
VITE_SCOPES=openid profile email

# Production overrides (set these in your hosting dashboard, not locally)
VITE_PROD_API_BASE_URL=
VITE_PROD_REDIRECT_URI=

# Development settings
VITE_DEV_CLIENT_PORT=3001
VITE_DEV_CLIENT_HOST=localhost

# ── FAPI 2.0 ────────────────────────────────────────────────────────────────────
# The FAPI wizard needs its own client, scope and redirect URI. None of the three can be the
# SPA's general-purpose values, and each fails differently if it is:
#
#   VITE_FAPI_CLIENT_ID   must be a CONFIDENTIAL client using private_key_jwt. FAPI 2.0 5.3.2.1
#                         says the server "shall only support confidential clients", so the SPA's
#                         own public client cannot complete this flow at all.
#   VITE_FAPI_SCOPES      must include a scope carrying Authlete's `fapi2` attribute. That
#                         attribute is what selects FAPI 2.0 processing per request, which is how
#                         one service hosts this flow and the ~20 ordinary OAuth panels beside it.
#                         A FAPI request that omits the tagged scope is not a FAPI request.
#   VITE_FAPI_REDIRECT_URI  must be https. FAPI 2.0 5.3.2.2 forbids the http scheme, so the
#                         development callback on localhost is refused — which means the wizard's
#                         browser redirect leg cannot complete against a local server.
VITE_FAPI_CLIENT_ID=1241400020
VITE_FAPI_SCOPES=openid myscope
VITE_FAPI_REDIRECT_URI=https://oauth2-0-1.onrender.com/callback

# The authorization server's ISSUER IDENTIFIER — the `issuer` member of its discovery document.
# Deliberately separate from VITE_API_BASE_URL: in a deployment they are the same origin, but
# running the SPA against a local server they are not, because the issuer stays whatever the
# Authlete service is configured with. A private_key_jwt assertion and a JAR request object both
# put this in `aud`, and FAPI 2.0 5.3.2.1 lets the server accept nothing else there.
# Defaults to VITE_API_BASE_URL when unset.
VITE_ISSUER=https://oauth2-0-ekh2.onrender.com
